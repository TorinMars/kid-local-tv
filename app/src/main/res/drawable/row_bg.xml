<?xml version="1.0" encoding="utf-8"?>
<!-- A setting row in a card: the focused one fills with the accent colour, like a focused button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/accent" /><corners android:radius="12dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#00000000" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
