<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/safe_h"
    android:paddingTop="@dimen/safe_v"
    android:paddingEnd="@dimen/safe_h"
    android:paddingBottom="@dimen/safe_v">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="40dp">

        <TextView
            android:id="@+id/setup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SetupStep"
            android:layout_marginTop="20dp"
            android:text="@string/setup_step1" />

        <TextView
            style="@style/SetupStep"
            android:text="@string/setup_step2" />

        <TextView
            android:id="@+id/setup_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="24dp"
            android:textColor="@color/accent"
            android:textIsSelectable="false"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SetupStep"
            android:text="@string/setup_step3" />

        <TextView
            android:id="@+id/setup_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/setup_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/setup_done"
            style="@style/TvButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:enabled="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/remote_help"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/qr_bg"
        android:padding="12dp">

        <ImageView
            android:id="@+id/setup_qr"
            android:layout_width="@dimen/qr_size"
            android:layout_height="@dimen/qr_size"
            android:contentDescription="@null"
            android:visibility="invisible" />
    </FrameLayout>
</LinearLayout>
